# Supabase — Settings → API in the dashboard. The anon key is public by design;
# row-level security is the enforcement layer.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — web push. The VAPID *public* key is safe to ship to the client;
# leave it unset to hide the push toggle entirely. Generate a keypair with
# `npx web-push generate-vapid-keys`. See "Enabling push" in the README.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Playwright e2e credentials for the seeded demo accounts (supabase/seed.sql).
# Never commit real values — this repo is public.
E2E_PASSWORD=demo-accounts-password
E2E_STAFF_PASSWORD=staff-account-password

# ─── Fresh-project setup ──────────────────────────────────────────────────────
# 1. Create a Supabase project and apply supabase/migrations/*.sql in order
#    (SQL Editor, or `supabase db push` with the CLI).
# 2. Seed demo data:
#    psql $DB_URL -v demo_password='…' -v staff_password='…' -f supabase/seed.sql
# 3. Auth → URL Configuration: set the Site URL (local: http://localhost:5173).
# 4. Copy this file to .env and fill in the values above.
