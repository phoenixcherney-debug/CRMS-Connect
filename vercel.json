{
  "redirects": [
    { "source": "/applications",     "destination": "/applications",       "permanent": true },
    { "source": "/my-applications",  "destination": "/applications",       "permanent": true },
    { "source": "/jobs",             "destination": "/opportunities",      "permanent": true },
    { "source": "/jobs/new",         "destination": "/opportunities/new",  "permanent": true },
    { "source": "/jobs/:id",         "destination": "/opportunities/:id",  "permanent": true },
    { "source": "/jobs/:id/edit",    "destination": "/opportunities/:id/edit",       "permanent": true },
    { "source": "/jobs/:id/applicants","destination": "/opportunities/:id/applicants","permanent": true },
    { "source": "/my-postings",      "destination": "/my-opportunities",   "permanent": true },
    { "source": "/postings",         "destination": "/student-posts",      "permanent": true },
    { "source": "/my-posts",         "destination": "/student-posts/mine", "permanent": true },
    { "source": "/feed",             "destination": "/activity",           "permanent": true },
    { "source": "/inbox",            "destination": "/messages",           "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
